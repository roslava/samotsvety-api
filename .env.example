# Application
APP_ENV=development
APP_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=samotsvety
DB_SSLMODE=disable

# Logging
LOG_LEVEL=info

# Admin API Key (для защиты POST/PUT/DELETE)
ADMIN_API_KEY=super-secret-admin-key-change-me

# Yandex Object Storage (set real credentials only in local environment)
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_REGION=ru-central1
YC_S3_BUCKET=lithoteka-cdn
